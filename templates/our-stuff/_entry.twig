{% extends "_layout" %}

{% block content %}
    <div class="flex flex-col bg-gray-400 py-16 px-12 mb-12">

        <div class="relative">
           <h1 class="text-gray-700 leading-none text-uppercase font-normal xs:text-4xl md:text-6xl md:text-8xl ml-8">
            {{ entry.title }}
          </h1>        
        </div>
    </div>
<div class="flex-wrap flex xs:flex-wrap-reverse md:flex-wrap m-12">
	<div class="xs:w-full md:w-1/3 border-t border-gray-400 py-8 px-2 my-8">
		<div class="my-4">
			{% if entry.links |length %}
				<h5 class="xs:text-center md:text-left text-gray-800 text-sm uppercase">
					Links
				</h5>
				{% for row in entry.links %}
					<div class="xs:text-center md:text-left">
						<a href="{{ row.linkUrl }}" class="text-blue-600 hover:text-red">{{ row.linkTitle }}</a>
					</div>
				{% endfor %}
			{% endif %}
			{% if entry.download |length %}
			{% set assets = entry.download.all() %}
				<div class="my-2">
					<h5 class="xs:text-center md:text-left text-gray-800 text-sm uppercase">
						Downloads
					</h5>
					{% for rel in assets %}
						<a href="{{ rel.url }}" class="hover:text-red text-xs" target="_blank">
							 {{ rel.title }}  <i class="far fa-file-pdf"></i> 
						</a>
					{% endfor %}
				</div>
				
			{% endif %}
		</div>

		<h5 class="xs:text-center md:text-left text-sm uppercase">
			Share
		</h5>

		<div class="border-b border-gray-400 mx-auto py-4 pb-16">
		  {% include "partials/_share" %}     
		</div>
	</div>
	
	<div class="xs:w-full md:w-2/3 border-t border-gray-400 p-8 my-8">

	 	<div>
				<h2 class="xs:text-center md:text-left text-gray-600 xs:text-xl md:text-2xl lg:text-3xl my-4">
					{{ entry.excerpt  |replace ({
						'<a href': '<a class="text-gray-700 hover:text-red" href',
					})|raw}}
				</h2>
			</div> 
		<div>
			<h3 class="text-gray-700 font-sm xs:text-center md:text-left my-2">
				by {{ entry.ideasAuthor }}
			</h3>
			<h4 class="text-gray-700 font-sm xs:text-center md:text-left mt-2 mb-12">
				{{ entry.postDate | date("M d, Y") }}
			</h4> 
		</div>
		<div>

		
		{% if entry.type == 'articles' %}
			{% include "our-stuff/partials/_entrytype/article.twig" %}
		{% elseif entry.type == 'videos' %}
			{% include "our-stuff/partials/_entrytype/video.twig" %}
		{% elseif entry.type == 'tools' %}
			{% include "our-stuff/partials/_entrytype/tool.twig" %}
		{% endif %}		
			

			
		</div>
	</div>
</div>
{% endblock %}
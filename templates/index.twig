
{# ===== mulagofoundation.org :: mulago.org/index ===== #}

{% extends "_layout" %}
  {% set title = entry.title %}
{% block content %}

{% for user in craft.users %}
{% if not user.isCurrent %}
    {% redirect "construction" %}
{% endif %}
{% endfor %}
{# <!-- Main content :: cleaning up and adding fellows secondary image support #}
  {% set blocks = entry.homePanels.all() %}
  {% for block in blocks %}
    
  {% switch block.type %}
  
    {% case "panel" %}
      {% include "partials/_homepanel.twig" %} 

    {% case "fellowsPanel" %}
      {% include "partials/_homefellowspanel.twig" %}   
  
    
  
  {% endswitch %}
  {% endfor %}


{% endblock %}

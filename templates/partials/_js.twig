 <script>
new Vue({
    el: '#mobile',
    data: {
        view: {
            menu: false,
            dropdown: {
                fellows: {
                    button: true,
                    elements: false,
                }
            }
        }
    },
    computed: {
        menuClass() {
            return {
                'block': this.view.menu,
                'hidden': !this.view.menu,
            }
        },
        dropdownFellowsClass() {
            return {
                'md:hidden': !this.view.dropdown.fellows.elements,
            }
        }
    },
    methods: {
        toggleMenu() {
            this.view.menu = !this.view.menu;
        },
        toggleDropdownFellows() {
            this.view.dropdown.fellows.elements = !this.view.dropdown.fellows.elements;
        },
        hideDropdown() {
            Object.keys(this.view.dropdown).forEach(key => this.view.dropdown[key].elements = false);
        },
        getWindowWidth() {
            const w = window,
                  d = document,
                  e = d.documentElement,
                  g = d.getElementsByTagName('body')[0],
                  x = w.innerWidth || e.clientWidth || g.clientWidth;
            return x;  
        }
    },
    mounted() {
        document.addEventListener('click', this.hideDropdown, false);
    }
});
</script>
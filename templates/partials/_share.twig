{# email  #}          
    <a class="rounded-full h-10 w-10 flex items-center justify-center bg-gray-600 hover:bg-red ml-2" href="mailto:?subject=From Mulago Foundation: {{ entry.title }}&amp;body=Have a look at this article: {{ entry.Url }}" title="Share by Email">
      <i class="text-xl text-white far fa-envelope"></i>
    </a>

{# print #}
    <a class="rounded-full h-10 w-10 flex items-center justify-center bg-gray-600 hover:bg-red ml-2" href="javascript:window.print()">
      <i class="text-xl text-white fas fa-print"></i>
    </a>
                    
</div>

{# share scripts #}

    <script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src="https://platform.twitter.com";fjs.parentNode.insertBefore(js,fjs);}}(document,"script","twitter-wjs");</script>

    <div id="fb-root"></div>
    <script>(function(d, s, id) {
      var js, fjs = d.getElementsByTagName(s)[0];
      if (d.getElementById(id)) return;
      js = d.createElement(s); js.id = id;
      js.src = "//connect.facebook.net/en_US/sdk.js#xfbml=1&version=v2.0";
      fjs.parentNode.insertBefore(js, fjs);
    }(document, 'script', 'facebook-jssdk'));</script>


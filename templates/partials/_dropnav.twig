<div id="app">
  <nav class="flex flex-wrap items-center bg-gray-100 p-6 font-sans antialiased">
    <div class="flex items-center flex-no-shrink text-gray-600 mr-6">
      <span class="font-bold italic text-xl tracking-tight">TicketAssist</span>
    </div>
    <div class="flex items-center">
      <dropdown-link>
        <span slot="link" class="appearance-none flex items-center inline-block text-gray-600">
        
        </span>
        <div slot="dropdown" class="bg-white shadow rounded border overflow-hidden">
          <a href="#" class="no-underline block px-4 py-3 border-b text-gray-800 bg-white hover:text-gray-600 hover:bg-blue">Henry</a>
          <a href="#" class="no-underline block px-4 py-3 border-b text-gray-800 bg-white hover:text-gray-600 hover:bg-blue">Rainer</a>
        </div>
      </dropdown-link>
    </div>
  </nav>
</div>
<script type="text/x-template" id="dropdown-link-template">
  <div class="relative">
    <div role="button" class="inline-block select-none" @click="open = !open">
      <slot name="link"></slot>
    </div>
    <div class="absolute right-0 w-full mt-2" v-show="open">
      <slot name="dropdown"></slot>
    </div>
  </div>
</script>


{% js %}
  Vue.component('dropdown-link', {
  template: '#dropdown-link-template',
  data() {
    return {
      open: false
    }
  }
})

var app = new Vue({
  el: '#app'
})

{% endjs %}

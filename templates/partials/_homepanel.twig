{% for image in block.image %}      

  <div class="bg-cover bg-auto bg-center" 
  style="background-image: url( {{ image.getUrl('lg1600x600') }}">
    <div class="xs:p-8 md:p-16 lg:p-32">
      {% set rel = block.pageLink.first() %}
      {% if rel|length %}
        {% for rel in block.pageLink %}
          <a class="hover:text-red text-gray-200 leading-none text-shadow font-normal xs:text-6xl md:text-7xl lg:text-10xl" href="{{ rel.url }}">
            <h2 class="opacity-75">
              {{ block.heading |nl2br }} 
            </h2>
          </a>
        {% endfor %}
        {% else %}
          <h2 class="text-gray-200 leading-none opacity-75 text-shadow font-normal xs:text-6xl md:text-7xl lg:text-10xl">
              {{ block.heading |nl2br }} 
            </h2>
      {% endif %}
    </div>
 </div> 

{% endfor %}

<div class="max-w-3xl text-center font-light text-gray-700 m-auto xs:my-4 md:my-8 lg:my-12" data-scroll-index="0">
  <h2 class="xs:text-xl md:text-2xl lg:text-4xl">
  {{ block.subHead }}
  </h2>
  <p class="xs:text-base md:text-xl lg:text-2xl pt-8"> 
  {{ block.copy }}
  </p>
</div> 
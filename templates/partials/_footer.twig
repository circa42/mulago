<footer class="bg-gray-300 pb-2 pt-8 px-8">

  <div class="flex xs:flex-wrap justify-between">

{# office #}
    <div class="xs:w-full md:w-1/3 xs:text-center md:text-left xs:mb-8 md:mb-4">
      {# email #}
        {% for row in social.newsletter %}
          
        
        <a class="xs:text-center md:text-right text-sm text-gray-600 hover:text-red font-semibold cursor-pointer" data-fancybox data-type="iframe" data-src="{{ row.url }}" href="javascript:;">
          {{ row.cta }} 
        </a>
        {% endfor %}
    </div>

{# tagline & arrow #}	
    <div class="xs:w-full md:w-1/3">

      <h2 class="sm:w-full text-center uppercase text-gray-600 text-2xl tracking-wider">
        {{ tagline.text }}
      </h2>

	  </div>

{# social #}
    <div class="xs:w-full md:w-1/3 flex flex-wrap xs:justify-center md:justify-end mb-8">
      
      {% if social.socialTable |length %}
        {% for row in social.socialTable %}
          <div class="m-2 rounded-full h-12 w-12 flex items-center justify-center bg-gray-600 hover:bg-red border-white border-2">
            <a href="{{ row.socialUrl }}" 
              target="_blank">
              <i class="text-white text-2xl pt-2 {{ row.socialIcon }}"></i>  
            </a>
          </div>
        {% endfor %}
      {% endif %}
  
    </div>

  </div>


      <h4 class="text-center text-sm text-gray-600">
        &copy; {{ now |date('Y') }} {{ copyright.text }}
      </h4>


</footer>     
  <div class="bg-blue-700 h-4"></div>


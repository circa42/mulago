<footer class="bg-gray-300 pb-2 pt-8 px-8">

  <div class="flex xs:flex-wrap justify-between">

{# office #}
    <div class="xs:w-full md:w-1/3 xs:text-center md:text-left xs:mb-8 md:mb-4">
      <p class="text-gray-600 text-sm">
        <span class="font-semibold">
        Our office is located at:</span><br>
        {{ address.copy |nl2br }}
      </p>
    </div>

{# tagline & arrow #}	
    <div class="xs:w-full md:w-1/3">

      <h2 class="sm:w-full text-center uppercase text-gray-600 text-2xl tracking-wider">
        {{ tagline.text }}
      </h2>
        
      <div class="flex justify-center m-12">
        <a href="#" class="" data-scroll-nav="0">
          <div class="rounded-full h-16 w-16 flex items-center justify-center bg-gray-600 hover:bg-gray-800 border-2 border-white button">
            <i class="text-white hover:text-gray-300 text-4xl fas fa-angle-up"></i>
          </div>
        </a>
      </div>

	  </div>

{# social #}
    <div class="xs:w-full md:w-1/3 flex flex-wrap xs:justify-center md:justify-end mb-8">
      
      {% if social.socialTable |length %}
        {% for row in social.socialTable %}
          <div class="m-2 rounded-full h-12 w-12 flex items-center justify-center bg-gray-600 hover:bg-gray-800 border-white border-2">
            <a href="{{ row.socialUrl }}" 
              target="_blank">
              <i class="text-white hover:text-gray-300 text-2xl pt-2 {{ row.socialIcon }}"></i>  
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>


  </div>

 
  <div>
    <h4 class="xs:text-center md:text-right text-sm text-gray-600">
      &copy; {{ now |date('Y') }} {{ copyright.text }}
    </h4>
  </div>
</footer>     
  <div class="bg-blue-700 h-4"></div>


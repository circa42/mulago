{% set segment = craft.app.request.segments|first %}




<div class="font-sans antialiased" id="app">
  <nav class="flex justify-between flex-wrap p-6">
    <div class="flex flex-shrink text-white mr-6">
      <div class="h-8 mr-2 flex-shrink xs:w-32 lg:w-56 m-auto">
        <a href="{{ siteUrl }}">
          <img src="{{ siteUrl }}assets/img/mulago-signature600.png" alt="{{ tagline.text }}">
        </a>
      </div>
    </div>
    <div class="block md:hidden">
      <button @click="toggle" class="flex items-center px-3 py-2 border rounded text-blue-700 border-blue-700 hover:text-red hover:border-red">
        <svg class="fill-current h-3 w-3" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><title>Menu</title><path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/></svg>
      </button>
    </div>
    

    <div :class="open ? 'block': 'hidden'" class="w-full flex-grow md:flex md:items-center md:w-auto">
        
      <div class="md:flex text-sm md:flex-grow justify-end">
          {% for row in navigation.navTable %}
            <div class="border-r border-gray-400 text-center pl-2 xs:border-0 my-4">
              <a href="{{ row.linkUrl }}" class="uppercase text-xs no-underline mt-2 md:mt-0 text-gray-900 border-t-2 border-transparent hover:border-red 
              {% if segment == row.linkUrl %} border-red {% endif %} xs:text-center p-2">
                 {{ row.linkName }}
              </a>
            </div>
          {% endfor %}
            

                        <div class="relative group">
                            <a href="#" class="no-underline text-red md:text-gray-800 flex items-center py-4 border-b border-blue-800 group-hover:border-gray-light">
                                Settings
                            </a>

                            <div class="items-center absolute border border-t-0 rounded-b-lg p-1 bg-white p-2 invisible group-hover:visible w-auto">
                               <a href="#" class="px-4 py-2 block text-black hover:bg-gray-lighter">Manage Stores</a>
                               <a href="#" class="px-4 py-2 block text-black hover:bg-gray-lighter">Manage Users</a>
                               <hr class="border-t mx-2 border-gray-ligght">
                               <a href="#" class="px-4 py-2 block text-black hover:bg-gray-lighter">Example Nav</a>
                            </div>
                        </div>




          <div class="border-r border-gray-400 text-center pl-2 xs:border-0 my-4">
            <a href="{{ siteUrl }}search" class="text-xs no-underline  md:mt-0 text-gray-900 hover:text-red text-center ml-2 my-4 pt-4">
              <i class="fas fa-search"></i>
            </a>
          </div>
      </div>

    </div>

  </nav>
</div>


{% js %}
   
  
new Vue({
  el: '#app',
  data: {
    open: false,
  },
  methods: {
    toggle() {
      this.open = !this.open
    }
  }
})

 {% endjs %}

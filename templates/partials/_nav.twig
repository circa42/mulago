{# search #}
          <div class="border-r border-gray-400 text-center pl-2 xs:border-0 my-4">
            <a href="{{ siteUrl }}search" class="text-xs no-underline  md:mt-0 text-gray-900 hover:text-red text-center ml-2 my-4 pt-4">
              <i class="fas fa-search"></i>
            </a>
          </div>

      </div>

    </div>
  </nav>
</div>
{# bumper div to prevent content under the menu #}
<div class="pb-24 bg-white"></div>





  {# dropdown - works on click 

           <div id="app" class="bg-gray-300">
            <dropdown-link>
              <div slot="link" class="uppercase text-xs no-underline mt-2 md:mt-0 text-gray-900 border-t-2 border-transparent hover:border-red {% if segment == 'fellows' %} border-red {% endif %} xs:text-center p-2">
                Our Fellows
              </div>
              <nav slot="dropdown" class="bg-white overflow-hidden">
                  <a href="fellows/henry-fellows" class="block uppercase text-xs no-underline mt-2 md:mt-0 text-gray-900 border-t-2 border-transparent hover:border-red border-red xs:text-center p-2">
                    Henry Fellows
                  </a>
                  <a href="fellows/rainer-fellows" class="block uppercase text-xs no-underline mt-2 md:mt-0 text-gray-900 border-t-2 border-transparent hover:border-red border-red xs:text-center p-2">
                    Rainer Fellows
                  </a>
              </nav>
            </dropdown-link> 
          </div>

<div type="text/x-template" id="dropdown-link-template">
  <div class="relative">
     <div role="button" class="inline-block select-none" @click="open = !open">
      <slot name="link"></slot>
    </div>
    <div class="" v-show="open">
      <slot name="dropdown"></slot>
    </div>
  </div> 



{% js %}
  Vue.component('dropdown-link', {
  template: '#dropdown-link-template',
  data() {
    return {
      open: false
    }
  }
})

var app = new Vue({
  el: '#app'
})
{% endjs %}

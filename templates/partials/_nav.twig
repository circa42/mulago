

{% set segment = craft.app.request.segments|first %}




<div class="font-sans antialiased w-full z-50 bg-white opacity-90 shadow-lg fixed h-24" id="mobile">
  <nav class="flex justify-between flex-wrap p-6">
    <div class="flex flex-shrink text-white mr-6">
      <div class="h-8 mr-2 flex-shrink xs:w-32 lg:w-56 m-auto">
        <a href="{{ siteUrl }}">
          <img src="{{ siteUrl }}assets/img/mulago-signature600.png" alt="{{ tagline.text }}">
        </a>
      </div>
    </div>
    <div class="block md:hidden">
      <button @click="toggle" class="flex px-3 py-2 border rounded text-blue-700 border-blue-700 hover:text-red hover:border-red">
        <svg class="fill-current h-3 w-3" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><title>Menu</title><path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/></svg>
      </button>
    </div>
    

    <div :class="open ? 'block': 'hidden'" class="bg-white w-full flex-grow md:flex md:items-center md:w-auto">
        
      <div class="md:flex md:flex-grow justify-end">
          
          {% for row in navigation.navTable %}
            <div class="text-center pl-2 xs:border-0 my-4">
              <ul class="list-none">
                <li>
                  <a href="{{ siteUrl }}{{ row.linkUrl }}" class="uppercase text-xs no-underline mt-2 md:mt-0 text-gray-900 border-t-2 border-transparent hover:border-red 
                  {% if segment == row.linkUrl %} border-red {% endif %} xs:text-center p-2">
                     {{ row.linkName }}
                  </a>
                </li>
              </ul>
            </div>
          {% endfor %}
          
{#           <div class="group text-center pl-2 xs:border-0 my-4">
              <div class="group-hover:bg-gray-300 cursor-pointer uppercase text-xs no-underline mt-2 md:mt-0 text-gray-900 border-t-2 border-transparent hover:border-red 
              border-red xs:text-center p-2">

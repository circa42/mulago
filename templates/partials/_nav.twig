
{# establishes if the user is on that page #}
{% set segment = craft.app.request.segments|first %}




<div class="font-sans antialiased w-full z-40 bg-white md:opacity-90 shadow-lg fixed h-24" id="mobile">

  <nav class="flex justify-between flex-wrap p-6">
    <div class="flex flex-shrink text-white mr-6 pb-4">
      <div class="h-8 mr-2 flex-shrink xs:w-32 lg:w-56 m-auto">
        <a href="{{ siteUrl }}">
          <img src="{{ siteUrl }}assets/img/mulago-signature600.png" alt="{{ tagline.text }}">
        </a>
      </div>
    </div>
    <div class="block md:hidden">
      <button @click.prevent="toggleMenu" class="flex px-3 py-2 border rounded text-blue-800 border-blue-700 hover:text-red hover:border-red">
        <svg class="fill-current h-3 w-3" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><title>Menu</title><path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/></svg>
      </button>
    </div>
    
{# mobile button #}
    <div :class="menuClass" class="bg-white w-full flex-grow md:flex md:items-center md:w-auto">
        <div class="md:flex md:flex-grow justify-end">
           
          {% for row in navigation.navTable %}
              <div class="text-center pl-2 xs:border-0 my-4">                    
                  
                    {% if row.linkUrl == 'fellows' %}                     
                       {% include "partials/_dropnav.twig" %} 
                     {% else %}   
                      <div>
                        <a href="{{ siteUrl }}{{ row.linkUrl }}" class="uppercase text-xs no-underline mt-2 md:mt-0 text-gray-900 border-transparent border-t-2 hover:text-red 
                      {% if segment == row.linkUrl %} border-red {% endif %} xs:text-center p-2">
                          {{ row.linkName }}
                        </a>
                      </div>
                  {% endif %}
              </div>
          {% endfor %}

{# search btn #}
<div class="flex justify-center">
  <button id="searchButton" onclick="getFocus()" type="button"><i class="fas fa-search text-xs text-gray-900 hover:text-red text-center pl-2 focus:outline-none mb-2"></i></button>
</div>


      </div>

    </div>
  </nav>

{# search box #}
          <div id="searchBox" class="hidden h-16 bg-white border border-gray-500 px-4 py-2">
            <form class="text-gray-500 text-4xl" action="{{ url('search/results') }}">
                <input type="search" id="mySearch" name="q" placeholder="Search ..." class="w-full focus:outline-none h-12" autofocus width="100%">
            </form>
          </div>
</div>
{# bumper div to prevent content under the menu #}
<div class="pb-24 bg-white"></div>





{% js %}
$(document).ready(function(){
  $("#searchButton").click(function(){
    $("#searchBox").fadeToggle(400);
    $(this).find('i').toggleClass('fa-search fa-times-hexagon')
  });
});
{% endjs %}


        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

        <title> {{ siteName }} {% if title is defined %} :: {{ title }}{% endif %}</title>

        <meta name="description" content="{{ siteDescription.text }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-touch-fullscreen" content="yes">
        <meta property="og:url" content="{% if entry.url is defined %}{{ entry.url }}{% endif %}"/>
        <meta property="og:title" content="{% if title is defined %}{{ title|length ? title : entry.title }}{% endif %}" />
        <meta property="og:image" content="thumbnail_image"/>

{# <!-- Place favicon.ico and apple-touch-icon.png in the root directory --> #}
      <link rel="home" href="{{ siteUrl }}" />
      <link rel="shortcut icon" href="{{ siteUrl }}favicon.ico" type="image/x-icon" />
      <link rel="apple-touch-icon" href="{{ siteUrl }}apple-touch-icon-precomposed.png"> 
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/fancyapps/fancybox@3.5.7/dist/jquery.fancybox.min.css" />

        <link rel="stylesheet" href="{{ siteUrl }}assets/css/styles.css">
        <link rel="stylesheet" href="https://use.typekit.net/yca3xii.css">
        <link rel="stylesheet" type="text/css" href="{{ siteUrl }}assets/css/slick.css"/>
        <link rel="stylesheet" type="text/css" href="{{ siteUrl }}assets/css/slick-theme.css"/>
        <link href="/assets/css/all.css" rel="stylesheet">

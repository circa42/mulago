
<div class="hidden" id="{{ entry.id }}">

	<div class="text-center font-light bg-white shadow hover:border-gray-400 max-w-lg border p-4 m-4">
		{% set assetQuery = entry.bioPhoto %}
		{% set images = assetQuery.all() %}
			{% for image in images %}
				<div class="flex justify-center">
					<img src="{{ image.geturl('sq300x300') }}" alt="">
				</div>
			{% endfor %}
			<h3 class="uppercase text-xl text-gray-700 py-4">
			{{ entry.title }}
			</h3>

			<div class="border-b border-gray-400">
			</div> 
			<h3 class="uppercase text-sm text-gray-700 py-4">
			{{ entry.position }} 
			</h3>
			<p class="font-light">{{ entry.bioCopy }}</p>
			
			
			<div class="flex justify-center">
				{% if entry.linkedin|length %}
					<div class="m-2 rounded-full h-12 w-12 flex items-center justify-center bg-gray-600 hover:bg-gray-800 border-white border-2 my-2">
						<a href="{{ entry.linkedin }}" 
			              target="_blank">
			              <i class="text-white hover:text-gray-300 text-2xl pt-2 fab fa-linkedin-in"></i>  
			            </a>
		          	</div>
	          	{% endif %}
	          	{% if entry.twitter|length %}
		          	<div class="m-2 rounded-full h-12 w-12 flex items-center justify-center bg-gray-600 hover:bg-gray-800 border-white border-2 my-2">
						<a href="{{ entry.twitter }}" 
			              target="_blank">
			              <i class="text-white hover:text-gray-300 text-2xl pt-2 fab fa-twitter"></i>  
			            </a>
		          	</div>
	          	{% endif %}
          	</div>
          	
		
	</div>		
</div>



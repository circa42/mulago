
<div class="hidden" id="{{ entry.id }}">

	<div class="text-center bg-white shadow hover:border-gray-400 max-w-lg border p-4 m-4">
		{% set assetQuery = entry.bioPhoto %}
		{% set images = assetQuery.all() %}
			{% for image in images %}
				<div class="flex justify-center">
					<img src="{{ image.geturl('sq300x300') }}" alt="">
				</div>
			{% endfor %}
			<h3 class="uppercase text-xl text-gray-700 py-4">
			{{ entry.title }}
			</h3>

			<div class="border-b border-gray-400">
			</div> 
			<h3 class="uppercase text-sm text-gray-700 py-4">
			{{ entry.position }} 
			</h3>
			{{ entry.bioCopy }}
		
	</div>		
</div>
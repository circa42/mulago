{# ===== mulagofoundation.org :: fellows/index ===== #}

 {% set title = ('Fellows') %}
 {% block content %}


  
<!-- Main content -->
<div class="main-content">

    <div class="ideas-panel-1 m-ltgray" data-scroll-index="0">
      <div class="container">
         <div class="row">
             <h1 class="text-uppercase">{{ category }}</h1>
        </div>
      </div>
    </div>


<!-- strapline -->
    <div class="container-p" style="padding-bottom: 1%;  padding-left: 1%;  padding-right: 1%;">
      <h3 class="fellowsquote" style="line-height: 1.5em; font-size: 1.5em;"><em>{{ category.fellowsCategoryDescription }}</em>
        <br>
      {% set program = craft.request.lastSegment %}

        {% if program == 'rainer-fellows' %}
          <button type="button" class="btn m-blue center-block">
            <a href="{{ url('rainer-fellows-program') }}" style="text-decoration: none;" class="m-mdgray">
              <h4 style="color:white;">ABOUT THE PROGRAM »</h4>
            </a>
          </button>
        {% elseif program == 'henry-fellows' %}
           <button type="button" class="btn m-blue center-block">
            <a href="{{ url('henry-fellows-program') }}" style="text-decoration: none;" class="m-mdgray">
              <h4 style="color:white;">ABOUT THE PROGRAM »</h4></a>
         {% endif %}
       </h3>
    </div>

<div> <!--container -->
     <!-- entry blocks -->
  <div class="section m-ltltgray">


                 {% set entryIds = craft.entries.section('fellows').all() %}
                 {% set tags = craft.tags({
                    relatedTo: [
                      'and', 
                    { sourceElement: entryIds },
                    
                    ],
                    
                     }).groupId(2).find() | reverse %}

                      {% for tag in tags %}
                        {% set entries = craft.entries({
                            relatedTo: [
                              'and',
                              { targetElement: category },
                              { targetElement: tag },
                              ],
                              limit: (null),
                          }) 
                        %}
                        {% if entries is not empty %}
                          {% if tags is defined and category is defined %}
                           <div class="p-cat m-ltblue clearfix" id="tags" data-scroll-index="3">
                              <h3>{{ tag.slug }} {{ category.title }}</h3>
                            </div>                      
                            {% else %} 
                          {% endif %}
                          <div class="container-p clearfix" id="entries">
                            {% for entry in entries %}
                              {% include 'fellows/_entryblock.twig' %} 
                            {% endfor %} 
                          </div>
                        {% endif %}
                   {% endfor %} 

  </div><!-- end gray -->
</div><!-- end container -->
{% endblock %}

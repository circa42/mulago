  {% for matrixBlock in entry.fellowsEntry %}
    {% if matrixBlock.type == 'entryContent' %}

      <a href="{{ entry.url }}" class=""> 
                 
        <div class="bg-white shadow hover:border-gray-400 max-w-xs border p-4 m-4">
            {% set assetQuery = matrixBlock.fellowImage.all() %}
              {% for image in assetQuery %} 
               <img src="{{ image.geturl('sq300x300') }}" alt="">
              {% endfor %}
              <h3 class="uppercase font-light text-base text-center text-gray-700 py-4">
                {{ entry.title }}
              </h3>
              
              <div class="border-b border-gray-400">
              </div> 
              <h3 class="min-h-4xs uppercase font-light text-base text-center text-gray-700 px-8 py-6">
                {{ matrixBlock.organization }} 
              </h3>
        </div>
      </a> 

    {% endif %}
  {% endfor %} 
{% extends "_layout" %}

{% block content %}
<div class="flex flex-col bg-blue-700 py-16 px-12 mb-12">
    <div class="relative">
       <h1 class="text-white leading-none text-uppercase font-semibold xs:text-2xl md:text-3xl md:text-6xl ml-8">
        {{ category.title }}
      </h1>        
    </div>
</div>

<div class="flex flex-wrap-reverse container font-light bg-white md:pr-12 md:pl-4 m-4">

	<div class="xs:w-full lg:w-3/4">
		{# all of the entries related to this section #}
		{% set entries = craft.entries.relatedTo(category).all() %}

		{% include "blog/_entries" %}
	</div>
	{% include "blog/_sidebar" %}
</div>

{% endblock %}
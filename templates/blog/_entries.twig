{# Output them #}
		{% for entry in entries %}

		{% set assetQuery = entry.mainImage %}



		<div class="flex flex-wrap-reverse m-12">
			
		    <div class="xs:w-full md:w-3/4 xs:p-0 xs:pt-4 md:pt-0 md:pr-12">
		    	<h2 class="text-2xl">
		    		<a href="{{ entry.url }}" class="font-bold hover:text-red">
			    		{{ entry.title }}
			    	</a>
			    </h2>
		    	<p class="text-left">
		    		{{ entry.excerpt }} 
		    	</p>
		    	<a href="{{ entry.url }}" class="font-bold text-red hover:underline">
		    		Read More » 
		    	</a>	
		   
		    </div>
		    <div class="xs:w-full md:w-1/4">
				{% set images = assetQuery.all() %}
					{% for image in images %}
						<div class="flex justify-center">
							<a href="{{ entry.url }}">
								<img src="{{ image.geturl('index300x200') }}" alt="">
							</a>
						</div>
					{% endfor %}
			</div>
		</div>
		{% endfor %}
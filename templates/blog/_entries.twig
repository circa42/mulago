{% paginate entries as pageInfo, pageEntries %}
{# Output them #}
        {% for entry in pageEntries %}

        {% set assetQuery = entry.mainImage %}



        <div class="flex flex-wrap xs:m-8 md:m-12">
            
            <div class="xs:w-full md:w-1/4">
                {% set images = assetQuery.all() %}
                    {% for image in images %}
                        <div class="flex justify-center">
                            <a href="{{ entry.url }}">
                                <img src="{{ image.geturl ('index300x200') }}" alt="">
                            </a>
                        </div>
                    {% endfor %}
            </div>

            <div class="xs:w-full md:w-3/4 xs:p-0 xs:pt-4 md:pt-0 md:pl-12">
                <h2 class="xs:text-2xl lg:text-4xl">
                    <a href="{{ entry.url }}" class="font-bold hover:text-red">
                        {{ entry.title }}
                    </a>
                </h2>
                <p class="text-left">
                    {{ entry.excerpt }} 
                </p>
                <p class="text-left my-4">
                    by {% include "blog/_authors" %}
                </p>
                <a href="{{ entry.url }}" class="font-bold text-red hover:underline">
                    Read More » 
                </a>    
           
            </div>
            
        </div>
        {% endfor %}

{% include "blog/_pagination" %}
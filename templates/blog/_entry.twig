{% extends "_layout" %}

{% block content %}
<div class="flex flex-col bg-blue-700 py-16 xs:px-0 md:px-8 mb-12">

    <div class="relative mx-8">
       <h1 class="text-white leading-none text-uppercase font-semibold xs:text-3xl md:text-4xl md:text-6xl ">
        {{ entry.title }}
      </h1>
      <h3 class="text-white leading-none xs:text-lg md:text-xl md:text-2xl py-4">
            {{ entry.excerpt }}
      </h3>        
    </div>
</div>
<div class="xs:mx-8 md:mx-20">
	<h3 class="text-left">
		by {% include "blog/_authors" %}
	</h3>
	<h4 class="text-gray-700 font-sm text-left my-2">
		{{ entry.postDate | date("M d, Y") }}
	</h4> 
</div>
<div class="flex-wrap flex xs:flex-wrap md:flex-wrap xs:mx-0 md:mx-12 max-w-6xl">
	
	
	<div class="xs:w-full md:w-3/4 border-t border-gray-400 p-8 my-8">

		<div>
            {% include "blog/_content" %}    
            {% include "blog/_comments" %}
		</div>
	</div>

{# sidebar #}
	<div class="xs:w-full md:w-1/4 border-t border-gray-400 py-8 px-2 my-8">
		<h5 class="xs:text-center md:text-left text-sm uppercase">
			Latest Posts
		</h5>
		{% include "blog/_posts" %}


		<h5 class="xs:text-center md:text-left text-sm uppercase">
			Categories
		</h5>
		<div class="mb-10">
			{% include "blog/_cat" %}
			
		</div>

		<h5 class="xs:text-center md:text-left text-sm uppercase">
			Share
		</h5>

		<div class="border-b border-gray-400 mx-auto py-4 pb-16">
		  {% include "partials/_share" %}     
		</div>
	</div>


</div>



{% endblock %}
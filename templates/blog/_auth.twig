{% set entryIds = craft.entries.section('blog').all() %}
{% set categories = craft.categories.relatedTo({ sourceElement: entryIds }).groupId(8).all() %}

{# Display the navigation #}
<ul>
    {% nav category in categories %}
		<li class="mb-2">

			<a href="{{ category.url }}" class="text-gray-700 font-sm no-underline hover:underline hover:text-red my-2">
            	{{ category.title }}
            </a>

        </li>
    {% endnav %}
</ul>

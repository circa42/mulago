{% set entryIds = craft.entries.section('blog').ids() %}
{% set categories = craft.categories.relatedTo({ sourceElement:
  entryIds }).groupId(9).all() %}

  

<ul>
    {% nav category in categories %}
		<li class="mb-2">
            <a href="{{ category.url }}" class="text-gray-700 font-sm no-underline hover:underline hover:text-red my-2">
            	{{ category.title }}
            </a>
            {% ifchildren %}
                <ul class="ml-2">
                    {% children %}
                </ul>
            {% endifchildren %}
        </li>
    {% endnav %}
</ul>


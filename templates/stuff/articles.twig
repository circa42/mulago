{% extends "_layout" %}

{% block content %}
    {# Articles #}
{% set stuffQ = craft.entries.section('stuff') %}
{% set articles = stuffQ.all() %}

    {# Articles #}
<div class="bg-gray-200 p-12">

      <div class="flex flex-wrap justify-between">
        {# subnav #}
        <div>
          {% include "stuff/partials/_breadcrumb.twig" %}
        </div>
        <div>
          {% include 'stuff/partials/_subnav.twig' %}
        </div>

        <div class="flex justify-center flex-wrap m-8">
          
            {% for entry in articles %}
              {% if entry.type == 'articles' %}
                  {% include "stuff/partials/_article-block.twig" %}
              {% endif %}  
            {% endfor %}
        </div>

      </div> 
    </div> 


</div> 
{% endblock %}
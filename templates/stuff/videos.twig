    <div class="">
      <div class="flex flex-wrap m-8">
        
          {% for entry in videos %}
            {% if entry.type == 'videos' %}
              {% include "stuff/partials/_video-block.twig" %}
            {% endif %}  
          {% endfor %}
      </div>

    </div> 
  </div> 
{% endblock %}
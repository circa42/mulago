{% set categories = craft.categories.group('resourcesCat').all() %}
{% for category in categories %}
  
{% set seg = craft.app.request.getSegment(2) %}


  <div class="inline-block 
  		{% if seg == category.slug %}
  		border-t-2 border-red {% endif %} pt-2 m-2">
    <a href="{{ category.url }}" class="text-gray-800 hover:text-gray-600">
      <h5 class="uppercase">
        {{ category.title }}
      </h5>

    </a>
  </div>
{% if loop.last %}{%else%} | {%endif%} 
{% endfor %}

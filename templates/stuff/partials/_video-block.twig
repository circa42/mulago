

  <div class="xs:w-full lg:w-1/2">
      <div class="bg-white p-4 min-h-xl m-4">
          <div class="flex justify-center mb-4 text-center">


              {% set blocks = entry.videoMatrix.limit(1).all() %}
                {% for block in blocks %}

                  {% if block.type == 'videoBlock' %}
    
                    {% if block.videoId|length %}
                    <div class="overflow-hidden">
                      <iframe width="540" height="310" src="https://www.youtube.com/embed/{{ block.videoId }}" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                    {% endif %}
                  {% endif %}
                {% endfor %}  
   

          </div>
           <a href="{{ entry.url }}" class="right uppercase uppercase text-gray-800 hover:text-red">
              <h3 class="">
              {{ entry.title }}
            </h3>
          </a>
          <small class="">{{ entry.postDate | date("M d, Y") }}</small>
          <article class="text-gray-600 pt-4">
            {{ entry.excerpt |raw }}
          </article>
          <div class="text-right pt-4 text-sm">
              <a href="{{ entry.url }}" class="right uppercase text-blue-800 hover:text-red">
                Read more » 
              </a>
          </div>
        
      </div>
  </div>

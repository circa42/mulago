{# Tools #}
{% extends "_layout" %}

{% block content %}
    {# tools #}
{% set stuffQ = craft.entries.section('stuff') %}
{% set tools = stuffQ.all() %}

    {# tools #}
<div class="bg-gray-200 p-12">

  <div class="">
    {% include "stuff/partials/_breadcrumb.twig" %}
    <div class="flex flex-wrap m-8">
      
        {% for entry in tools %}
          {% if entry.type == 'tools' %}
              {% include "stuff/partials/_tool-block.twig" %}
          {% endif %}  
        {% endfor %}
    </div>

  </div> 
</div> 

{% endblock %}
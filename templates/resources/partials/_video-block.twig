<div class="w-1/3">
  <a href="{{ entry.url }}" class="hover:border-gray-800">
    <div class="bg-white p-4 m-4">
        <div class="flex justify-center mb-4 text-center">
          <iframe class="" src="https://www.youtube.com/embed/{{ entry.videoEmbed | raw }}" frameborder="0" allowfullscreen>
          </iframe>
        </div>
         <h3 class="uppercase text-gray-800 hover:text-gray-600">
          {{ entry.title }}
        </h3>
        <small class="">{{ entry.postDate | date("M d, Y") }}</small>
        <article class="text-gray-600 pt-4">
          {{ entry.excerpt |raw }}
        </article>
        <div class="text-right pt-4 text-sm">
            <a href="{{ entry.url }}" class="right uppercase text-blue-800 hover:text-blue-600">
              Read more » 
            </a>
        </div>
      
    </div>
  </a>
</div>
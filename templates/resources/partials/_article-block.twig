

<a href="{{ entry.url }}" class="hover:border-red">
  <div class=" max-w-sm min-w-sm bg-white p-4 m-4">
    {% set assets = entry.resourcePhoto.all() %}
      {% if entry.resourcePhoto | length %}
        {% for asset in assets %}
          <div class="shadow mb-4">
              <img src="{{ asset.url('resources380x240') }}" alt="{{ asset.title }}">
          </div>
        {% endfor %}
      {% endif %}
    <div class="">
      <h3 class="min-h-6xs uppercase text-gray-800 hover:text-red">
        {{ entry.title }} 
      </h3>
       <small class="">{{ entry.postDate | date("M d, Y") }}</small> 
      <article class="min-h-3xs text-base text-gray-600 pt-4">
        {{ entry.excerpt |raw}}
      </article>
      <div class="text-right text-xs">
          <a href="{{ entry.url }}" class="right uppercase text-blue-800 hover:text-red">
            Read more » 
          </a>
      </div>
    </div>
    
  </div>
</a>






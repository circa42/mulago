{# Articles all #}


{# This works fine -- but not for sub categories #}

 
<div class="row">
  <div class="col" style="padding-top: 10em;">

{% set catUrl = craft.request.getLastSegment() %}
{% set category = craft.categories.slug('articles').getChildren() %}

      
    {% if catUrl == 'soapbox' %}
      {% set category = craft.categories.slug('soapbox').getChildren() %}

    {% elseif catUrl == 'design'%}
      {% set category = craft.categories.slug('design').getChildren() %}

    {% elseif catUrl == 'fund' %}
      {% set category = craft.categories.slug('fund').getChildren() %}

    {% elseif catUrl == 'communications' %}
      {% set category = craft.categories.slug('communications').getChildren() %}



    {% endif %}



{# breadcrumb #}
         <h2 style="text-transform: uppercase;"> {{ category.slug }} </h2>
            {% include 'resources/_breadcrumb.twig' %}


{% set entries = craft.entries.section('resources').relatedTo(category) %}

{# subnav #}
          <div class="row">
            <div class="col">
              <nav class="sub-nav" style="position: relative;">
                  <ul class="scroll-to">

                  {% for sibling in craft.categories.group('resourcesCat').level(2) %}

                    <li><a href="{{ sibling.url }}"><h5 class="text-uppercase p22-demi">{{ sibling.slug }}</h5></a></li>
                  {% endfor %}

                  </ul>



              </nav>  
            </div>
          </div>



{# entries #}
         
            <div class="clearfix">
            </div>

        {% if entries | length %}
         {% for entry in entries  %}

          <div class="row">
            {% set assets = entry.resourcePhoto %}
              {% if entry.resourcePhoto | length %}
                <div class="col-sm-11 col-md-12 col-lg-6 clearfix" style="margin-bottom: 4em;">
                  {% for asset in assets %}
                    <a href="{{ entry.url }}">
                      <img  src="{{ asset.url('resourcesPhoto2x') }}" alt="{{ asset.title }}">
                    </a>
                </div>      
                  {% endfor %}
              {% else %}
                 <div class="col-xs-4 col-sm-8 col-md-8 col-lg-12 clearfix"></div>
              {% endif %}
             
              
               <div class="col-sm-11 col-md-12 col-lg-6">
              
                <br>
                <h2><a href="{{ entry.url }}">  {{ entry.title }}</a></h2>
                <small class="text-uppercase">{{ entry.postDate | date("M d, Y") }}</small>
                <p>{{ entry.ideasExcerpt }}</p>
                <p><strong><a href="{{ entry.url }}">Read More » </a></strong></p>
              </div>

            </div>
         {% endfor %}
      {% endif %}


  </div>  
</div>  
 
{% extends "_layout" %}

{% block content %}
    <div class="flex flex-col bg-gray-400 py-16 px-12 mb-12">

        <div class="relative">
           <h1 class="text-gray-700 leading-none text-uppercase font-normal xs:text-4xl md:text-6xl md:text-8xl ml-8">
            {{ entry.title }}
          </h1>        
        </div>
    </div>
<div class="flex-wrap flex m-12">
	<div class="xs:w-full md:w-1/3 border-t border-gray-400 py-8 px-2 my-8">
		<div class="my-4">
			{% if entry.links |length %}
				<h5 class="xs:text-center md:text-left text-gray-800 text-sm uppercase">
					Links
				</h5>
				{% for row in entry.links %}
					<div class="xs:text-center md:text-left">
						<a href="{{ row.linkUrl }}" class="text-blue-600 hover:text-blue-400">{{ row.linkTitle }}</a>
					</div>
				{% endfor %}
			{% endif %}
			{% if entry.download |length %}
				<h5 class="xs:text-center md:text-left text-gray-800 text-sm uppercase">
					Downloads
				</h5>
			{% endif %}
		</div>

		<h5 class="xs:text-center md:text-left text-sm uppercase">
			Share
		</h5>

		<div class="border-b border-gray-400 mx-auto py-4">
		  {% include "includes/_share" %}     
		</div>
	</div>
	
	<div class="xs:w-full md:w-2/3 border-t border-gray-400 p-8 my-8">
		<div>
			<h3 class="xs:text-center md:text-right">
				{{ entry.ideasAuthor }}
			</h3>
			<h4 class="xs:text-center md:text-right">
				{{ entry.postDate | date("M d, Y") }}
			</h4>
		</div>
		<div>
			<h2 class="xs:text-center md:text-left text-gray-600 text-4xl my-8">
				{{ entry.excerpt |raw }}
			</h2>
		</div>
		<div>
			{% set blocks = entry.contentBuilder.all() %}
			{% for block in blocks %}
				{% if block.type == 'copyBlock' %}
					<div class="text-xl leading-loose list-disc text-gray-800">
						
						{{ block.copy |replace({
								'<ul>': '<ul class="list-disc py-4 pl-8">',
								'<p>': '<p class="py-2">',	
									})|raw }}
					</div>
				{% elseif block.type == 'imageBlock' %}

					
				{% endif %}
				
			{% endfor %}
		</div>
	</div>
</div>
{% endblock %}
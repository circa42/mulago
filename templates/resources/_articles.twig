    {# Articles #}

    {# Articles #}
    <div class="row">
      <div class="col" style="padding-top: 10em;">

        {% set category = craft.categories('articles') %}
        {% set catUrl = craft.request.getLastSegment() %}

           <a href="{{ siteUrl }}{{ craft.request.getSegment(1) }}/articles"><h2 style="text-transform: uppercase;">Articles </h2>
           </a>

{# subnav #}
{% include 'resources/_articles-subnav.twig' %}


{% set category = craft.categories.slug('articles').find() %}
{% set entries = craft.entries.section('resources').relatedTo(category).limit(3) %}

       <div class="row">
        {% if entries | length %}
           {% for entry in entries  %}
                <div class="col-sm-8 col-md-4" style="margin-bottom:40px;">
                  {% set assets = entry.resourcePhoto %}
                    {% if entry.resourcePhoto | length %}
                      {% for asset in assets %}
                        <a href="{{ entry.url }}">
                          <img src="{{ asset.url('resources380x240') }}" alt="{{ asset.title }}">
                        </a>
                      {% endfor %}
                    {% endif %}
                  <h3><a href="{{ entry.url }}">{{ entry.title }}</a></h3>
                  <small class="text-uppercase">{{ entry.postDate | date("M d, Y") }}</small>
                    
                </div>
           {% endfor %}
        {% endif %}
      </div>

      </div> {# end col #}
    </div> {# end row #}



</div> {# end row #}
 
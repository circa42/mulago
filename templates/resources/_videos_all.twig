    {# Videos #}

    <div class="row">
      <div class="col" style="padding-top: 10em;">
        {% set category = craft.categories.slug('videos') %}
        {% set entries = craft.entries.section('resources').relatedTo(category) %}

           <a href="{{ category.slug }}"><h2 style="text-transform: uppercase;"> {{ category.slug }} </h2>
           </a>
            {% include 'resources/_breadcrumb.twig' %}
          </div>
    </div> 

        <div class="row">
        {% if entries | length %}

            {% for entry in entries %}
              <div class="col-sm-12  col-md-6">
                <a href="{{ entry.url }}"><h3>{{ entry.title }}</h3></a>

                {% for matrixBlock in entry.ideasPost.limit(1) %}
                {% switch matrixBlock.type %}
                     
                 {% case "ideasCopy" %}

                    {# {{ matrixBlock.copy }} #}

                 {% case "ideasImage" %}

                  {% for image in matrixBlock.image %}

                    <img class="full" src="{{ image.getUrl('resources270x180') }}" alt="">
                  {% endfor %}

                 {% case "ideasVideo" %}
                  {# <h3>{{ matrixBlock.videoTitle }}</h3> #}
                 <div class="embed-responsive embed-responsive-16by9">
                   <iframe class="embed-responsive-item ideas" src="https://www.youtube.com/embed/{{ entry.videoEmbed | raw }}" frameborder="0" allowfullscreen></iframe>

                   {# old 190628
                    <iframe class="embed-responsive-item ideas" src="{{ matrixBlock.video | raw }}" frameborder="0" allowfullscreen></iframe> #}
                 </div>
              
                {% endswitch %}


              {% endfor %}

              </div>
            {% endfor %}

        {% endif %}
        </div>


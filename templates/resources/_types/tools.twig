{# Tools #}
{% extends "_layout" %}

{% block content %}
    {# tools #}
{% set resourcesQ = craft.entries.section('resources') %}
{% set tools = resourcesQ.all() %}

    {# tools #}
<div class="bg-gray-200 p-12">

  <div class="">
    {% include "resources/partials/_breadcrumb.twig" %}
    <div class="flex flex-wrap m-8">
      
        {% for entry in tools %}
          {% if entry.type == 'tools' %}
            <a href="{{ entry.url }}">
              {% include "resources/partials/_tool-block.twig" %}
            </a>
          {% endif %}  
        {% endfor %}
    </div>

  </div> 
</div> 

{% endblock %}

   {# Tools #}

   <div class="row">
      <div class="col" style="padding-top: 10em;">
        {% set category = craft.categories.slug('tools') %}
        {% set entries = craft.entries.section('resources').relatedTo(category).find() %}

           <a href="{{ category.slug }}"><h2 style="text-transform: uppercase;"> {{ category.slug }} </h2>
           </a>
              {% include 'resources/_breadcrumb.twig' %}

        {% if entries | length %}

            {% for entry in entries %}
              <div class="col-sm-6  col-md-4" style=" padding-bottom: 8em;">
                <a href="{{ entry.url }}"><h3>{{ entry.title }}</h3></a>
                <p>{{ entry.ideasExcerpt }}</p>
                <a href="{{ entry.url }}">
                  <p><strong>Download</strong></p>
                </a>
              </div>

            {% endfor %}
        {% endif %}

      </div> {# end col #}
    </div> {# end row #}